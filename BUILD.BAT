@ECHO OFF
REM Build APPDIRS.COM using Borland Turbo Assembler / Turbo Linker

IF NOT EXIST BUILD MKDIR BUILD
IF NOT EXIST BUILD\LOG MKDIR BUILD\LOG

ECHO Build started: APPDIRS.COM > BUILD\LOG\RUN.LOG

TASM SRC\APPDIRS.ASM,BUILD\APPDIRS.OBJ,BUILD\APPDIRS.LST > BUILD\LOG\TASM.LOG
IF ERRORLEVEL 1 GOTO ERROR
TYPE BUILD\LOG\TASM.LOG >> BUILD\LOG\RUN.LOG

TLINK /Tde BUILD\APPDIRS.OBJ,BUILD\APPDIRS.COM > BUILD\LOG\TLINK.LOG
IF ERRORLEVEL 1 GOTO ERROR
TYPE BUILD\LOG\TLINK.LOG >> BUILD\LOG\RUN.LOG

ECHO Build succeeded: BUILD\APPDIRS.COM >> BUILD\LOG\RUN.LOG
GOTO END

:ERROR
ECHO Build failed. >> BUILD\LOG\RUN.LOG

:END
